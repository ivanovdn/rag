.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Qdrant data
qdrant_data/

# Node
frontend/node_modules/
frontend/dist/
frontend/build/

# Policies (may contain sensitive docs)
policies/*.docx
eval/datasets/*.json
eval/results
eval/*.xlsx

# Notebooks
notebooks/

# Teams bot data (tokens, state)
channels/teams/data/

# Top-level feedback/data dump
/data/

# Software list raw artifacts (JSON is the committed canonical source)
software/*.pdf

# Claude Code per-developer local settings
.claude/settings.local.json