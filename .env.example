# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:14b
EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.0
LLM_REQUEST_TIMEOUT=120
# How long Ollama keeps the model loaded after a request (Ollama default: 5m).
OLLAMA_KEEP_ALIVE=30m
# Ollama context window. 4096 is the only value proven safe against a CUDA
# crash on MoE models — raising it can reintroduce a production crash (see
# docs/superpowers/specs/2026-09-17-ollama-moe-cuda-crash.md).
OLLAMA_NUM_CTX=4096

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=compliance_policies
QDRANT_VECTOR_DIM=768

# Documents
POLICY_DOCS_FOLDER=./policies
POLICY_BASE_URL=http://intranet.company.com/policies

# Retrieval
MIN_CONFIDENCE_SCORE=0.45

# Reranker
# Relevance floor on the reranker's 0.0-1.0 score; 0.0 disables it. Matches the
# config.py default deliberately — a template that ships a floor OFF while the code
# default has it ON makes the guard depend on whether this file was copied.
# A backstop for absurd questions, not a precision knob: 0.2 sits 4.2x below the
# lowest score that produced a correct retrieval on chatbot-test-v1, and has fired
# on no production question (0 rejections across 45, 2026-09-22..10-06 — the only
# sub-threshold scores on record predate the floor). Do not raise it expecting
# precision: one of the two document misses scored 0.9886, so no threshold
# separates hits from misses on this corpus.
RERANKER_MIN_SCORE=0.2
# The ONE candidate count in retrieval: it sizes the dense prefetch, the sparse
# prefetch, and the fused limit they feed, so they cannot disagree. Read only
# when the reranker is on; with it off, retrieval returns search_policies' own
# top_k (6) instead, because 25 unranked chunks do not fit num_ctx 4096.
RERANKER_CANDIDATES=25

# Hybrid Search (BM25 sparse vectors, stored in Qdrant)
# BM25_ENABLED is query-side only: sparse vectors are always written at ingest,
# so flipping it needs no re-ingest. The collection must have a `bm25` sparse
# vector or the bot refuses to start — build one with
# scripts/migrate_collection.py. How many candidates each branch contributes is
# RERANKER_CANDIDATES, above; there is deliberately no per-branch count.
BM25_ENABLED=true
# BM25 length normalisation. Qdrant's default is 256; this corpus measures ~50.
# WRITE-TIME, unlike everything above it: avg_len is baked into every stored
# sparse vector and is inert at query time. Measured — the same text stored at
# avg_len 50 vs 256 gives 1.504788 vs 1.652097, while changing it on the query
# side alone changes nothing. So editing this does nothing until the vectors are
# re-encoded: migrate_collection.py into a fresh collection, or a full re-ingest.
# Re-ingesting ONE policy after changing it leaves that document normalised
# differently from all the others, undetectably — Qdrant discards collection-level
# BM25 config, so nothing records what a stored vector was encoded with.
BM25_AVG_LEN=50.0

# Agent
AGENT_TIMEOUT=120

# Router (pre-retrieval classification)
ROUTER_ENABLED=true
ROUTER_LLM_MODEL=
ROUTER_CONFIDENCE_FLOOR=0.6

# Chunking
CHUNK_MIN_TOKENS=50
CHUNK_MAX_TOKENS=400

# Observability (Phoenix)
PHOENIX_ENABLED=true
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=compliance-bot
EVAL_DATASET_PATH=eval/datasets

# Teams Bot (delegated user account; the bot rotates the refresh token into
# channels/teams/data/refresh_token.json — .env is only the seed)
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
# EXPIRES. Azure's "New client secret" dialog defaults to 6 months; the first one ran
# out on 2026-10-06 and took the bot down with a wall of 401s. Record the expiry date
# below when you rotate it, and prefer a 24-month lifetime. See SETUP.md Step 10.
# Expires: <date>
TEAMS_CLIENT_SECRET=
TEAMS_REFRESH_TOKEN=

# Teams polling (hours are UTC; the fast window applies Mon-Fri)
TEAMS_POLL_INTERVAL=5                 # inside business hours
TEAMS_IDLE_POLL_INTERVAL=30           # nights and weekends
TEAMS_BUSINESS_HOURS_START_UTC=7
TEAMS_BUSINESS_HOURS_END_UTC=19
TEAMS_MESSAGES_PAGE_SIZE=5            # $top per chat (Graph default: 20)
TEAMS_SHUTDOWN_GRACE_SECONDS=12       # SIGTERM drain bound; keep under the bot service's
                                      # stop_grace_period (30s in docker-compose-remote.yml)
